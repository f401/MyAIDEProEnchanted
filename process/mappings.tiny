	m	(Ljava/lang/String;)V	j6	onError	kind: 抽象回调方法，入参 String ⇒ 错误消息回调
	m	(Ljava/util/Map;)V	j6	onProducts	kind: 抽象回调方法，入参 Map ⇒ 商品列表回调
