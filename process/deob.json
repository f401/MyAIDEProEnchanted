{
  "name": "aide-pro-jgit",
  "root": ".",
  "probe_prefix": "abcd",
  "probe_dir": "../src/smali/abcd",
  "smali_index": "truth/smali_index.tsv",
  "parts": [
    {
      "dir": "truth/head",
      "probe_prefix": "abcd"
    },
    {
      "dir": "../jobs/jgit",
      "probe_prefix": "abcd"
    },
    {
      "dir": "../jobs/jsch",
      "probe_prefix": "com/jcraft/jsch"
    },
    {
      "dir": "../jobs/aide",
      "probe_prefix": "abcd"
    }
  ],
  "src_root": [
    "$HOME/src/jgit",
    "$HOME/out/oracle/jsch/src"
  ],
  "out_tsrg": "mappings.txt",
  "allow": "verify_allow.tsv",
  "base_jars": [
    "base/merged_ok.jar"
  ],
  "input_jars": [
    "src/classes.jar",
    "src/classes2.jar",
    "src/classes3.jar",
    "src/classes4.jar",
    "src/classes5.jar",
    "src/zh.jar",
    "src/en.jar",
    "src/ndk.jar",
    "src/packagingservice.jar"
  ],
  "oracle_jars": [
    {
      "label": "jgit-3.7.1",
      "path": "$HOME/out/oracle/jgit/j-3.7.1.201504261725-r.jar"
    },
    {
      "label": "jgit-4.11.9",
      "path": "$HOME/out/oracle/jgit/j-4.11.9.201909030838-r.jar"
    },
    {
      "label": "jgit-5.13.3",
      "path": "$HOME/out/oracle/jgit/org.eclipse.jgit-5.13.3.202401111512-r.jar"
    },
    {
      "label": "jsch-0.1.55",
      "path": "$HOME/out/oracle/jsch/jsch-0.1.55.jar"
    }
  ],
  "out_dir": "out"
}
